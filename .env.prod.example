# Copy to /opt/vaultiq/.env.prod on the VPS, fill in real values, then: chmod 600 .env.prod
# Never commit the filled-in version to git.
# Variable names below match backend/config.py exactly — do not rename these.

# Environment
# Must be "production" —  Turns on strict startup checks: app will refuse to boot 
# if it would otherwise silently fall back to SQLite or local disk storage.
APP_ENV=production

# Required for the `flask db upgrade` step in the deploy workflow to reliably
# resolve the app object, rather than relying on Flask CLI's filename-guessing
# fallback. Deliberately app.py, NOT wsgi.py: migrate.init_app(app, db) is
# called in app.py itself, which is everything `flask db upgrade` needs.
# wsgi.py additionally runs embedding-model + LLM warmup at import time
# (module-level code, not inside a function) — pointing FLASK_APP at wsgi.py
# would make a schema migration silently trigger a full model download/warmup
# first, adding latency and a new way for an unrelated LLM/HF hiccup to fail
# what should be a simple, fast schema-only deploy step.
FLASK_APP=app.py

# Core Secrets (required)
JWT_SECRET_KEY=jwt-secret-key-here
SECRET_KEY=secret-key-here

# Neon Postgres
# Standard postgres:// or postgresql:// URL — config.py normalizes the schema
# itself, don't pre-convert it.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Cloudflare R2 
# All 4 Must be set together or app falls back to local disk automatically 
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=r2-access-key-id-here
R2_SECRET_ACCESS_KEY=r2-secret-access-key-here
R2_BUCKET_NAME=vaultiq-uploads

# # Read automatically by the huggingface_hub client (not referenced directly
# in app code) — authenticates model downloads so you don't hit HF's
# anonymous-download rate limit on first container boot. Optional for a
# public model like the default below, but cheap insurance.
HF_TOKEN=huggingface-token-here

# LLM Provider
# LLM model (optional — defaults to Gemma 4 31B free)
#   Fallback chain kicks in automatically if this model is rate-limited:
#       Primary:   google/gemma-4-31b-it:free
#       Backup:    openai/gpt-oss-120b:free
#       Fallback:  openai/gpt-oss-20b:free
#       Emergency: openrouter/free
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemma-4-31b-it:free
OPENROUTER_API_KEY=openrouter-api-key-here

# HuggingFace Token
HF_TOKEN=huggingface-token-here


# LLM call tuning (set by docker-compose.prod.yml — listed here for reference)
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# RAG pipeline tuning 
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=5
INGEST_BATCH_SIZE=32

# Upload limits (client_max_body_size in nginx/prod.conf should stay comfortably above this)
MAX_UPLOAD_SIZE_MB=20
MAX_FILES_PER_UPLOAD=10

# Rate limiting
ASK_RATE_LIMIT=10 per minute
AUTH_RATE_LIMIT=5 per minute

# Logging
LOG_LEVEL=INFO
ENABLE_FILE_LOGGING=false

# Gunicorn
GUNICORN_WORKERS=1
# Must stay above the worst-case LLM fallback chain: 4 models x
# (LLM_MAX_RETRIES+1) attempts x LLM_TIMEOUT_SECONDS + backoff can approach
# ~300-370s if every model hits a transient failure before succeeding.
# Full chain: this (400s) < frontend's ASK_TIMEOUT (420s) < nginx's
# proxy_read_timeout (450s) -- keep all three in that order if any change.
GUNICORN_TIMEOUT=400